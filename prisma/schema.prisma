generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role       @default(CUSTOMER)
  cpf           String?    @unique
  phone         String?
  cart          Json?
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  favorites     Favorite[]
  carts         Cart[]
  payments      Payment[]
  addresses                 Address[]
  feedbacks                 Feedback[]
  twoFactorSecret           String?   @map("two_factor_secret")
  twoFactorEnabled          Boolean   @default(false) @map("two_factor_enabled")
  twoFactorActivatedAt      DateTime? @map("two_factor_activated_at")
  twoFactorRecoveryCodes    Json?     @map("two_factor_recovery_codes")
  questions                 ProductQuestion[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  sku         String?       @unique
  description       String?       @db.Text
  shortDescription  String?       @map("short_description") @db.Text
  price             Decimal       @db.Decimal(10, 2)
  oldPrice    Decimal?      @db.Decimal(10, 2)
  stock       Int           @default(0)
  images      String[]
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  status      ProductStatus @default(ACTIVE)
  featured    Boolean       @default(false)
  variants    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
  wishlist    Wishlist[]
  favorites   Favorite[]
  carts       Cart[]
  feedbacks   Feedback[]
  questions   ProductQuestion[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  total          Decimal     @db.Decimal(10, 2)
  paymentMethod  String
  paymentId      String?
  couponCode     String?
  couponDiscount Decimal?    @db.Decimal(10, 2)
  phone          String
  address        Json
  items          OrderItem[]
  payments       Payment[]
  feedbacks      Feedback[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  variants  Json?
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  rating           Int
  comment          String?  @db.Text
  verifiedPurchase Boolean  @default(false)
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip          String
  isDefault    Boolean @default(false)
}

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  variants  Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String?
  userId        String?
  provider      String        @default("mercadopago")
  method        String?
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String?       @unique
  rawResponse   Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String?
  description   String?     @db.Text
  type          CouponType  @default(PERCENTAGE)
  discount      Decimal     @db.Decimal(10, 2)
  minAmount     Decimal?    @db.Decimal(10, 2)
  maxDiscount   Decimal?    @db.Decimal(10, 2)
  maxUses       Int         @default(0)
  usedCount     Int         @default(0)
  usagePerUser  Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  usages        CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String?
  usedAt    DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([userId])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  linkLabel String?
  position  Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Feedback {
  id                    String            @id @default(uuid()) @db.Uuid
  authorName            String            @map("author_name") @db.VarChar(100)
  authorEmail           String            @map("author_email") @db.VarChar(255)
  authorAvatarUrl       String?           @map("author_avatar_url") @db.Text
  authorCompany         String?           @map("author_company") @db.VarChar(100)
  authorRole            String?           @map("author_role") @db.VarChar(100)
  authorLinkedinUrl     String?           @map("author_linkedin_url") @db.Text
  userId                String?           @map("user_id")
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone                 String?           @db.VarChar(40)
  serviceType           FeedbackService   @map("service_type")
  rating                Int
  title                 String            @db.VarChar(150)
  body                  String            @db.Text
  status                FeedbackStatus    @default(PENDING)
  priority              FeedbackPriority  @default(NORMAL)
  source                FeedbackSource    @default(site)
  productId             String?           @map("product_id")
  product               Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId               String?           @map("order_id")
  order                 Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resultMetric          String?           @map("result_metric") @db.VarChar(200)
  projectUrl            String?           @map("project_url") @db.Text
  videoUrl              String?           @map("video_url") @db.Text
  isVerified            Boolean           @default(false) @map("is_verified")
  isFeatured            Boolean           @default(false) @map("is_featured")
  // NEW: destaque específico na página de serviços
  isFeaturedServices    Boolean           @default(false) @map("is_featured_services")
  featuredServicesOrder Int               @default(0) @map("featured_services_order")
  isApproved            Boolean           @default(false) @map("is_approved")
  helpfulCount          Int               @default(0) @map("helpful_count")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  helpfulVotes          FeedbackHelpful[]

  @@index([isApproved, createdAt], map: "idx_feedbacks_approved")
  @@index([serviceType], map: "idx_feedbacks_service")
  @@index([isFeatured], map: "idx_feedbacks_featured")
  @@index([isFeaturedServices, featuredServicesOrder], map: "idx_feedbacks_featured_services")
  @@index([status, priority], map: "idx_feedbacks_status_priority")
  @@index([userId], map: "idx_feedbacks_user")
  @@index([productId], map: "idx_feedbacks_product")
  @@index([orderId], map: "idx_feedbacks_order")
  @@map("feedbacks")
}

model FeedbackHelpful {
  id          String   @id @default(uuid()) @db.Uuid
  feedbackId  String   @map("feedback_id") @db.Uuid
  fingerprint String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, fingerprint])
  @@map("feedback_helpful")
}

enum FeedbackService {
  landing_page
  site
  saas
  pacote_completo
  outro
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
}

enum FeedbackSource {
  site
  produto
  pedido
  suporte
  outro
}

enum BriefingStatus {
  PENDING
  CONTACTED
  IN_NEGOTIATION
  APPROVED
  REJECTED
  ARCHIVED
}

model ProjectBriefing {
  id                 String         @id @default(cuid())
  name               String
  email              String
  whatsapp           String
  companyName        String?        @map("company_name")
  serviceSlug        String         @map("service_slug")
  serviceName        String         @map("service_name")
  budget             String?
  deadline           String?
  projectDescription String         @map("project_description") @db.Text
  mainGoal           String?        @map("main_goal") @db.Text
  targetAudience     String?        @map("target_audience") @db.Text
  references         String?        @db.Text
  desiredFeatures    Json           @default("[]")
  hasDomain          Boolean?       @map("has_domain")
  hasHosting         Boolean?       @map("has_hosting")
  hasBranding        Boolean?       @map("has_branding")
  preferredContact   String?        @map("preferred_contact")
  extraNotes         String?        @map("extra_notes") @db.Text

  landingPageGoal             String? @map("landing_page_goal") @db.Text
  landingPageProduct          String? @map("landing_page_product") @db.Text
  landingPageNeedsForm        Boolean? @map("landing_page_needs_form")
  landingPageNeedsWhatsapp    Boolean? @map("landing_page_needs_whatsapp")
  landingPageNeedsLeadCapture Boolean? @map("landing_page_needs_lead_capture")
  landingPageNeedsEmailMarketing Boolean? @map("landing_page_needs_email_marketing")

  sitePagesCount       Int?     @map("site_pages_count")
  sitePagesList        Json?    @map("site_pages_list")
  siteNeedsAdmin       Boolean? @map("site_needs_admin")
  siteNeedsBlog        Boolean? @map("site_needs_blog")
  siteNeedsSeo         Boolean? @map("site_needs_seo")

  appNeedsLogin         Boolean? @map("app_needs_login")
  appNeedsAdmin         Boolean? @map("app_needs_admin")
  appNeedsDatabase      Boolean? @map("app_needs_database")
  appNeedsApi           Boolean? @map("app_needs_api")
  appNeedsPayments      Boolean? @map("app_needs_payments")
  appUserTypesCount     Int?     @map("app_user_types_count")
  appMainFeatures       String?  @map("app_main_features") @db.Text

  status    BriefingStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("project_briefings")
}

model ProductQuestion {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String  @map("author_name")
  question  String   @db.Text
  answer    String?  @db.Text
  answeredAt DateTime? @map("answered_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([userId])
  @@map("product_questions")
}

model StoreSettings {
  id              String   @id @default("singleton")
  storeName       String   @default("Café Store")
  storeDescription String? @db.Text
  storeEmail      String?
  whatsappNumber  String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#f97316")
  maintenanceMode Boolean  @default(false)

  // Pagamentos
  mercadoPagoPublicKey   String?  @map("mercado_pago_public_key")
  mercadoPagoAccessToken String?  @map("mercado_pago_access_token")
  acceptPix              Boolean  @default(true)  @map("accept_pix")
  acceptCreditCard       Boolean  @default(true)  @map("accept_credit_card")
  acceptBoleto           Boolean  @default(true)  @map("accept_boleto")
  acceptPayPal           Boolean  @default(false) @map("accept_paypal")
  pixExpiration          String   @default("30min") @map("pix_expiration")
  maxInstallments        Int      @default(12)    @map("max_installments")
  discountOnCash         Decimal  @default(0)     @map("discount_on_cash") @db.Decimal(5, 2)

  // Entrega e Frete
  enableFreeShipping    Boolean  @default(false) @map("enable_free_shipping")
  freeShippingAmount    Decimal? @map("free_shipping_amount") @db.Decimal(10, 2)
  showEstimatedDelivery Boolean  @default(true)  @map("show_estimated_delivery")
  calculateShipping     Boolean  @default(true)  @map("calculate_shipping")
  processingDays        Int      @default(1)     @map("processing_days")
  deliveryMessage       String?  @map("delivery_message")
  showTracking          Boolean  @default(true)  @map("show_tracking")

  // Notificações
  notifyNewOrder       Boolean @default(true) @map("notify_new_order")
  notifyPaidOrder      Boolean @default(true) @map("notify_paid_order")
  notifyCancelledOrder Boolean @default(true) @map("notify_cancelled_order")
  notifyNewUser        Boolean @default(true) @map("notify_new_user")
  notifyNewFeedback    Boolean @default(true) @map("notify_new_feedback")
  notifyNewBriefing    Boolean @default(true) @map("notify_new_briefing")
  notifyLowStock       Boolean @default(true) @map("notify_low_stock")
  lowStockThreshold    Int     @default(5)    @map("low_stock_threshold")
  adminEmails          String? @map("admin_emails") @db.Text

  // SEO
  metaTitle        String?  @map("meta_title")
  metaDescription  String?  @map("meta_description") @db.Text
  canonicalUrl     String?  @map("canonical_url")
  allowIndexing    Boolean  @default(true) @map("allow_indexing")
  googleAnalyticsId String? @map("google_analytics_id")
  facebookPixelId  String?  @map("facebook_pixel_id")
  sitemapUrl       String?  @map("sitemap_url")

  // Segurança
  requireTwoFactorAdmin   Boolean @default(false) @map("require_two_factor_admin")
  blockConcurrentSessions Boolean @default(false) @map("block_concurrent_sessions")
  sessionExpiration       String  @default("24h") @map("session_expiration")
  requireStrongPassword   Boolean @default(true)  @map("require_strong_password")

  // Aparência
  showAnnouncementBanner Boolean @default(true) @map("show_announcement_banner")
  announcementText       String? @map("announcement_text")
  forceDarkMode          String  @default("auto") @map("force_dark_mode")
  showReviewsOnHome      Boolean @default(true)  @map("show_reviews_on_home")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}
