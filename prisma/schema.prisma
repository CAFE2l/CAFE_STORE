generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role       @default(CUSTOMER)
  cpf           String?    @unique
  phone         String?
  cart          Json?
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  addresses     Address[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  price       Decimal       @db.Decimal(10, 2)
  oldPrice    Decimal?      @db.Decimal(10, 2)
  stock       Int           @default(0)
  images      String[]
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  status      ProductStatus @default(ACTIVE)
  featured    Boolean       @default(false)
  variants    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
  wishlist    Wishlist[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  image    String?
  products Product[]
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  total          Decimal     @db.Decimal(10, 2)
  paymentMethod  String
  paymentId      String?
  couponCode     String?
  couponDiscount Decimal?    @db.Decimal(10, 2)
  phone          String
  address        Json
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  variants  Json?
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  rating           Int
  comment          String?  @db.Text
  verifiedPurchase Boolean  @default(false)
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip          String
  isDefault    Boolean @default(false)
}

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Decimal   @db.Decimal(10, 2)
  type      String    @default("PERCENTAGE")
  minAmount Decimal?  @db.Decimal(10, 2)
  maxUses   Int       @default(0)
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Feedback {
  id                      String            @id @default(uuid()) @db.Uuid
  authorName              String            @map("author_name") @db.VarChar(100)
  authorEmail             String            @map("author_email") @db.VarChar(255)
  authorAvatarUrl         String?           @map("author_avatar_url") @db.Text
  authorCompany           String?           @map("author_company") @db.VarChar(100)
  authorRole              String?           @map("author_role") @db.VarChar(100)
  authorLinkedinUrl       String?           @map("author_linkedin_url") @db.Text
  serviceType             FeedbackService   @map("service_type")
  rating                  Int
  title                   String            @db.VarChar(150)
  body                    String            @db.Text
  resultMetric            String?           @map("result_metric") @db.VarChar(200)
  projectUrl              String?           @map("project_url") @db.Text
  videoUrl                String?           @map("video_url") @db.Text
  isVerified              Boolean           @default(false) @map("is_verified")
  isFeatured              Boolean           @default(false) @map("is_featured")
  // NEW: destaque específico na página de serviços
  isFeaturedServices      Boolean           @default(false) @map("is_featured_services")
  featuredServicesOrder   Int               @default(0)     @map("featured_services_order")
  isApproved              Boolean           @default(false) @map("is_approved")
  helpfulCount            Int               @default(0) @map("helpful_count")
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  helpfulVotes            FeedbackHelpful[]

  @@index([isApproved, createdAt], map: "idx_feedbacks_approved")
  @@index([serviceType], map: "idx_feedbacks_service")
  @@index([isFeatured], map: "idx_feedbacks_featured")
  @@index([isFeaturedServices, featuredServicesOrder], map: "idx_feedbacks_featured_services")
  @@map("feedbacks")
}

model FeedbackHelpful {
  id          String   @id @default(uuid()) @db.Uuid
  feedbackId  String   @map("feedback_id") @db.Uuid
  fingerprint String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, fingerprint])
  @@map("feedback_helpful")
}

enum FeedbackService {
  landing_page
  site
  saas
  pacote_completo
  outro
}
